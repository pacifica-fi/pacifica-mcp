{
	"name": "@pacifica-fi/mcp-server",
	"version": "0.2.1",
	"description": "MCP server for the Pacifica perpetual-futures exchange API",
	"type": "module",
	"license": "MIT",
	"author": "Pacifica",
	"homepage": "https://github.com/pacifica-fi/pacifica-mcp#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/pacifica-fi/pacifica-mcp.git"
	},
	"bugs": {
		"url": "https://github.com/pacifica-fi/pacifica-mcp/issues"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"pacifica",
		"perpetuals",
		"trading",
		"solana"
	],
	"engines": {
		"node": "^22.23.4 || ^24.22.1 || >=26.12.1"
	},
	"bin": {
		"mcp-server-pacifica": "dist/index.js"
	},
	"files": [
		"dist",
		"npm-shrinkwrap.json"
	],
	"bundleDependencies": [
		"@coral-xyz/anchor"
	],
	"publishConfig": {
		"access": "public"
	},
	"overrides": {
		"@coral-xyz/anchor": {
			"toml": "^4.2.0"
		},
		"jayson": {
			"uuid": "^11.1.1"
		}
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"test": "tsc --noEmit",
		"test:security": "tsx --test scripts/security-regression.test.ts",
		"prepare": "npm run build",
		"watch": "tsc --watch",
		"dev": "tsx watch src/index.ts",
		"gen:keys": "tsx scripts/gen-keypairs.ts",
		"smoke": "tsx scripts/smoke.ts",
		"smoke:1a": "tsx scripts/smoke-1a.ts",
		"smoke:1b": "tsx scripts/smoke-1b.ts",
		"smoke:1c": "tsx scripts/smoke-1c.ts",
		"smoke:1d": "tsx scripts/smoke-1d.ts",
		"smoke:3a": "tsx scripts/smoke-3a.ts",
		"smoke:3b": "tsx scripts/smoke-3b.ts",
		"smoke:3c": "tsx scripts/smoke-3c.ts",
		"smoke:3d": "tsx scripts/smoke-3d.ts",
		"smoke:3e": "tsx scripts/smoke-3e.ts",
		"smoke:agent": "tsx scripts/smoke-agent.ts",
		"smoke:faucet": "tsx scripts/smoke-faucet.ts",
		"smoke:deposit": "tsx scripts/smoke-deposit.ts"
	},
	"dependencies": {
		"@coral-xyz/anchor": "^0.30.1",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@solana/web3.js": "^1.98.0",
		"bs58": "^6.0.0",
		"tweetnacl": "^1.0.3",
		"axios": "^1.20.0",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@types/node": "^22.13.10",
		"typescript": "^5.8.2",
		"tsx": "^4.0.0"
	},
	"allowScripts": {
		"bufferutil@4.1.0": true,
		"esbuild@0.28.2": true,
		"utf-8-validate@6.0.6": true
	}
}
